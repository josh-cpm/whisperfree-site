---
// Homepage trust block (PR feedback §4). The point isn't only privacy — it's agency: you decide
// when your voice leaves the device.
const rows = [
  {
    mode: 'Local',
    badge: 'Default',
    badgeClass: 'bg-teal-100 text-teal-700',
    detail: 'Audio stays on your Mac. Transcription runs entirely on-device. Free.',
  },
  {
    mode: 'Cloud',
    badge: 'You switch it on',
    badgeClass: 'bg-amber-100 text-amber-700',
    detail: 'Only the clip you choose is sent for transcription. Metered by the second. Off until you flip the switch.',
  },
];
---

<section class="py-20 px-6">
  <div class="max-w-3xl mx-auto">
    <h2 class="text-3xl font-bold text-center mb-4">What leaves your Mac</h2>
    <p class="text-lg text-gray-600 text-center mb-12 max-w-2xl mx-auto">
      The point isn&rsquo;t just privacy &mdash; it&rsquo;s agency. You decide when your voice
      leaves the device, and the switch is explicit every time.
    </p>

    <div class="overflow-hidden rounded-2xl border border-gray-200">
      <table class="w-full text-left border-collapse">
        <thead class="bg-gray-50 text-sm text-gray-500">
          <tr>
            <th class="px-5 py-4 font-medium">Mode</th>
            <th class="px-5 py-4 font-medium">What happens</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr class="border-t border-gray-100 align-top">
              <td class="px-5 py-5 whitespace-nowrap">
                <span class="font-semibold text-gray-900">{row.mode}</span>
                <span class={`ml-2 inline-block text-xs font-semibold rounded-full px-2 py-0.5 ${row.badgeClass}`}>
                  {row.badge}
                </span>
              </td>
              <td class="px-5 py-5 text-gray-600">{row.detail}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="text-sm text-gray-500 mt-4 text-center">
      Full detail on what the provider receives is on the
      <a href="/pricing" class="text-teal-700 underline">cloud pricing page</a>.
    </p>
  </div>
</section>
