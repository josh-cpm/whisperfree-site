---
interface Props {
  href: string;
  size?: 'sm' | 'lg';
  class?: string;
}

const { href, size = 'lg', class: className = '' } = Astro.props;

const sizeClasses = size === 'lg' ? 'px-8 py-4 text-lg' : 'px-5 py-2 text-sm';
---

<a
  href={href}
  class:list={[
    'inline-flex items-center gap-2 bg-teal-600 text-white font-semibold rounded-xl no-underline transition-all hover:bg-teal-700 hover:shadow-lg hover:shadow-teal-600/20 active:scale-95',
    sizeClasses,
    className,
  ]}
>
  <slot />
</a>
