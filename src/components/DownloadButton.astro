---
import CtaButton from './CtaButton.astro';

interface Props {
  size?: 'sm' | 'lg';
  class?: string;
}

const { size = 'lg', class: className = '' } = Astro.props;
---

<CtaButton href="/download" size={size} class={className}>
  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <path d="M8 1v10M4 7l4 4 4-4M2 13h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
  Download Free
</CtaButton>
