---
import { getPricingView } from '../lib/pricing.ts';

const { anchors } = await getPricingView();

// The three pillars that explain the new product in one breath (PR feedback §3).
const pillars = [
  {
    title: 'Dictate locally for free',
    body: 'Runs on your Mac. No account. No cloud required. The default mode is free and stays that way.',
    icon: '<path d="M11 2L4 11h5l-1 7 7-9h-5l1-7Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>',
  },
  {
    title: 'Use cloud only for hard audio',
    body: 'Noise, names, accents, jargon, longer rambles — switch on a more accurate cloud model the moment accuracy matters.',
    icon: '<path d="M5 13a3 3 0 0 1 0-6 4 4 0 0 1 7.7-1.3A3.5 3.5 0 0 1 14 13H5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>',
  },
  {
    title: 'Pay cents, not a subscription',
    body: `Cloud is metered by the second. $5 lasts roughly ${anchors.hoursPerFiveDollars} hours of audio. No monthly plan, no lock-in.`,
    icon: '<path d="M10 3v14M6 7h6a2 2 0 0 1 0 4H8a2 2 0 0 0 0 4h6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>',
  },
];

// Keeps the "polished writing" capabilities in play (review §4) so the page doesn't read as
// cheaper-but-less-capable next to Wispr/Aqua.
const craft = [
  {
    title: 'Cleans up your speech',
    body: 'Punctuation, capitalization, and filler are sorted out so what lands reads like writing, not a transcript.',
  },
  {
    title: 'Teach it your words',
    body: 'Add the names and jargon you actually use, and it gets them right the first time.',
  },
  {
    title: 'Your own shortcuts',
    body: 'Write auto-corrections for the quirks you keep fixing by hand.',
  },
];
---

<section id="features" class="py-20 px-6">
  <div class="max-w-5xl mx-auto">
    <h2 class="text-3xl font-bold text-center mb-4">Local by default. Cloud by choice.</h2>
    <p class="text-lg text-gray-600 text-center mb-16 max-w-2xl mx-auto">
      One app, two modes &mdash; and you decide when your voice leaves your Mac.
    </p>

    <div class="grid sm:grid-cols-3 gap-8">
      {pillars.map((p) => (
        <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
          <div class="w-10 h-10 bg-teal-100 text-teal-700 rounded-xl flex items-center justify-center mb-4">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" set:html={p.icon} />
          </div>
          <h3 class="text-lg font-semibold mb-2">{p.title}</h3>
          <p class="text-gray-600 text-sm">{p.body}</p>
        </div>
      ))}
    </div>

    <div class="mt-16 pt-12 border-t border-gray-100">
      <h3 class="text-xl font-bold text-center mb-2">Made for real writing, not just transcription</h3>
      <p class="text-gray-600 text-center mb-10 max-w-2xl mx-auto">
        It still cleans up dictation for real writing &mdash; with the cloud reserved for the clips
        where accuracy matters.
      </p>
      <div class="grid sm:grid-cols-3 gap-6 max-w-4xl mx-auto">
        {craft.map((c) => (
          <div class="text-center sm:text-left">
            <h4 class="font-semibold text-gray-900 mb-1">{c.title}</h4>
            <p class="text-gray-600 text-sm">{c.body}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
