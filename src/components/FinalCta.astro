---
import DownloadButton from './DownloadButton.astro';
---

<section class="py-24 px-6 bg-gray-50">
  <div class="max-w-2xl mx-auto text-center">
    <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">
      Try the fastest private dictation app for Mac
    </h2>
    <p class="text-lg text-gray-600 mb-8 leading-relaxed">
      Download WhisperFree and start dictating locally for free. Use Precision Mode only when you
      want cleaner results.
    </p>
    <div class="flex justify-center">
      <DownloadButton size="lg" />
    </div>
    <p class="text-sm text-gray-400 mt-5">macOS 14+ &middot; Apple Silicon required</p>
  </div>
</section>
