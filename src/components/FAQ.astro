---
// Short homepage FAQ — resolve friction without another long marketing section (brief §3).
// Longer privacy/provider/language/open-source/competitor detail lives on dedicated pages.
const faqs = [
  {
    q: "Is WhisperFree really free?",
    a: "Yes. Local Mode is free to download and use on your Mac. Precision Mode is optional and uses credits only when you choose to use it."
  },
  {
    q: "How fast is it?",
    a: "In Local Mode, your words appear at the cursor as soon as you release the hotkey. There’s no upload step and no cloud round trip."
  },
  {
    q: "What is Precision Mode?",
    a: "Precision Mode is the optional mode for cleaner results when local dictation is more likely to make mistakes — names, accents, noise, jargon, and longer thoughts."
  },
  {
    q: "What leaves my Mac?",
    a: "In Local Mode, nothing leaves your Mac. In Precision Mode, only the audio you choose to send is processed by the cloud provider. Precision Mode is explicit and never turns on silently."
  },
  {
    q: "Why not just use built-in Mac dictation?",
    a: "WhisperFree is faster, more accurate, and teachable. You can add your own vocabulary and shortcuts so it handles the names, jargon, and phrases you actually use."
  },
  {
    q: "How is this different from Wispr Flow, Superwhisper, or Aqua?",
    a: "WhisperFree is local-first and free by default. Precision Mode is optional and credit-based, so you’re not forced into a monthly subscription to get better results."
  },
];
---

<section id="faq" class="py-20 px-6 bg-gray-50">
  <div class="max-w-3xl mx-auto">
    <h2 class="text-3xl font-bold text-center mb-12">Frequently asked questions</h2>

    <div class="space-y-6">
      {faqs.map(({ q, a }) => (
        <details class="bg-white rounded-xl border border-gray-200 group">
          <summary class="px-6 py-4 cursor-pointer font-semibold text-gray-900 flex items-center justify-between list-none">
            {q}
            <svg class="w-5 h-5 text-gray-400 transition-transform group-open:rotate-180 shrink-0 ml-4" viewBox="0 0 20 20" fill="none">
              <path d="M5 7l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </summary>
          <div class="px-6 pb-4 text-gray-600">
            {a}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
