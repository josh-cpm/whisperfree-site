---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getPricingView, centsToDollars } from '../lib/pricing.ts';

const { manifest, anchors, margin } = await getPricingView();

const title = 'Pricing — WhisperFree cloud models';
const description =
  'Cloud models in WhisperFree are billed by the second at the provider’s cost plus 10¢ per audio hour. No subscription or WhisperFree login. Local dictation stays free.';

// Spend anchors, rendered as cards (PMM §4b) — derived from the manifest, never hardcoded.
const costCards = [
  {
    value: `~${anchors.perFifteenMinCents}¢`,
    label: 'A heavy day of dictation — about 15 minutes of audio.',
  },
  {
    value: `~${anchors.hoursPerFiveDollars} hrs`,
    label: 'How much cloud transcription $5 of credit buys.',
  },
  {
    value: `~${anchors.monthsPerFiveDollarsAtOneHourPerWeek} months`,
    label: 'How long $5 lasts when you send one audio hour per week.',
  },
];

// Prescriptive "stay local vs switch" guidance (PMM §7).
const switchRows = [
  { context: 'Quiet room, clear speech', action: 'Stay local. It’s free and excellent.' },
  {
    context: 'Noisy environment, accents, jargon, names',
    action: `Switch to the cloud model — a clear accuracy jump where local struggles, roughly ${anchors.perFifteenMinCents}¢ for 15 minutes of audio.`,
  },
  { context: 'Unsure', action: 'Stay local; switch the moment you hit a bad transcription.' },
];

// Illustrative noisy-clip demo (café audio with names + jargon). Swap in a real captured clip later.
const demoLocal =
  'meet me at the cafe on the corner to talk about the postgres migration and the redis cash layer';
const demoCloud =
  'Meet me at the café on the corner to talk about the Postgres migration and the Redis cache layer.';
---

<Layout title={title} description={description} noindex={!manifest.enabled}>
  <Nav />
  <main>
    <!-- Header -->
    <section class="pt-32 pb-16 px-6">
      <div class="max-w-3xl mx-auto text-center">
        {manifest.enabled ? (
          <>
            <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-gray-900 mb-6">
              Pay <span class="text-teal-600">at cost</span>, plus 10&cent; an hour.
            </h1>
            <p class="text-xl text-gray-600 max-w-2xl mx-auto leading-relaxed">
              Local dictation is free and runs on your Mac. When you need more accuracy &mdash;
              noisy rooms, heavy accents, technical jargon &mdash; switch on a cloud model, billed
              by the second. No subscription. No WhisperFree login.
            </p>
          </>
        ) : (
          <>
            <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-gray-900 mb-6">
              Cloud model pricing
            </h1>
            <p class="text-xl text-gray-600 max-w-2xl mx-auto leading-relaxed">
              Local dictation remains free and runs on your Mac. Paid cloud transcription is not
              currently available.
            </p>
          </>
        )}
      </div>
    </section>

    {manifest.enabled ? (
      <>
        <!-- Cost breakdown table -->
        <section class="pb-20 px-6">
          <div class="max-w-3xl mx-auto">
            <div class="overflow-x-auto rounded-2xl border border-gray-200">
              <table class="w-full min-w-[640px] text-left border-collapse">
                <thead class="bg-gray-50 text-sm text-gray-500">
                  <tr>
                    <th class="px-5 py-4 font-medium">Model</th>
                    <th class="px-5 py-4 font-medium">Provider&rsquo;s price</th>
                    <th class="px-5 py-4 font-medium">Our price</th>
                    <th class="px-5 py-4 font-medium">What we add</th>
                  </tr>
                </thead>
                <tbody>
                  {manifest.models.map((m) => (
                    <tr class="border-t border-gray-100">
                      <td class="px-5 py-5 font-semibold text-gray-900">{m.label}</td>
                      <td class="px-5 py-5 text-gray-600">
                        {centsToDollars(m.estimatedProviderCentsPerAudioHour)}
                        <span class="text-gray-400"> / audio hr</span>
                      </td>
                      <td class="px-5 py-5">
                        <span class="font-bold text-teal-700">
                          {centsToDollars(m.estimatedTotalCentsPerAudioHour)}
                        </span>
                        <span class="text-gray-400"> / audio hr</span>
                      </td>
                      <td class="px-5 py-5 text-gray-600">
                        {centsToDollars(m.marginCentsPerAudioHour)} / hr
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <p class="text-sm text-gray-500 mt-4 text-center">
              We charge what the provider charges us, plus {margin} an hour for the infrastructure
              that meters it. That&rsquo;s the whole business model &mdash; no markup games, no
              &ldquo;contact sales.&rdquo; Providers&rsquo; billing quirks pass through too.
            </p>
          </div>
        </section>

        <!-- Anchor math -->
        <section class="py-20 px-6 bg-gray-50">
          <div class="max-w-3xl mx-auto">
            <h2 class="text-3xl font-bold text-center mb-4">What that actually costs</h2>
            <p class="text-lg text-gray-600 text-center mb-12 max-w-2xl mx-auto">
              An hour of dictated audio is a lot of dictation &mdash; most people dictate minutes a
              day. So &ldquo;cloud AI&rdquo; here means cents, not a monthly bill.
            </p>
            <div class="grid sm:grid-cols-3 gap-6">
              {costCards.map((card) => (
                <div class="bg-white rounded-2xl p-6 border border-gray-100 text-center">
                  <div class="text-3xl font-bold text-teal-700 mb-2">{card.value}</div>
                  <p class="text-gray-600 text-sm">{card.label}</p>
                </div>
              ))}
            </div>
            <p class="text-center text-gray-600 mt-10 max-w-2xl mx-auto">
              Most people dictate far less than they think. Per-second metering means you pay for
              the minutes you actually send. Add credit when you want it; there is no subscription.
            </p>
          </div>
        </section>

        <!-- Cloud explainer + noisy-clip demo -->
        <section class="py-20 px-6">
          <div class="max-w-3xl mx-auto">
            <h2 class="text-3xl font-bold text-center mb-4">Where a cloud model helps</h2>
            <p class="text-lg text-gray-600 text-center mb-12 max-w-2xl mx-auto">
              The local model is excellent in a quiet room. A frontier cloud model pulls ahead
              exactly where dictation breaks down &mdash; background noise, accents, names, and
              jargon. Same noisy clip, both models:
            </p>
            <div class="grid sm:grid-cols-2 gap-6">
              <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
                <div class="text-xs font-semibold uppercase tracking-wide text-gray-400 mb-3">
                  Local model
                </div>
                <p class="text-gray-700 leading-relaxed">{demoLocal}</p>
              </div>
              <div class="bg-teal-50 rounded-2xl p-6 border border-teal-100">
                <div class="text-xs font-semibold uppercase tracking-wide text-teal-600 mb-3">
                  Cloud model
                </div>
                <p class="text-gray-900 leading-relaxed">{demoCloud}</p>
              </div>
            </div>
            <p class="text-sm text-gray-400 mt-4 text-center">
              Illustrative example of a noisy clip with names and jargon.
            </p>
          </div>
        </section>

        <!-- When to switch -->
        <section class="py-20 px-6 bg-gray-50">
          <div class="max-w-3xl mx-auto">
            <h2 class="text-3xl font-bold text-center mb-12">When should you switch?</h2>
            <div class="space-y-4">
              {switchRows.map((row) => (
                <div class="bg-white rounded-xl border border-gray-200 p-6 flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-6">
                  <div class="sm:w-1/2 font-semibold text-gray-900">{row.context}</div>
                  <div class="sm:w-1/2 text-gray-600">{row.action}</div>
                </div>
              ))}
            </div>
          </div>
        </section>

        <!-- Privacy -->
        <section class="py-20 px-6">
          <div class="max-w-3xl mx-auto">
            <h2 class="text-3xl font-bold text-center mb-4">What leaves your Mac</h2>
            <p class="text-lg text-gray-600 text-center mb-12 max-w-2xl mx-auto">
              Local transcription stays local. Cloud transcription is explicit and off by default.
            </p>
            <div class="space-y-5">
              <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
                <h3 class="font-semibold text-gray-900 mb-2">Local mode (default)</h3>
                <p class="text-gray-600">
                  Speech audio, transcripts, vocabulary, and prompts stay on your Mac. Separately
                  opted-in anonymous diagnostics and feedback can use the network, but are designed
                  not to include that content.
                </p>
              </div>
              <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
                <h3 class="font-semibold text-gray-900 mb-2">Cloud mode (you switch it on)</h3>
                <p class="text-gray-600">
                  The selected clip passes through WhisperFree&rsquo;s backend in request memory and
                  then to OpenAI for transcription. WhisperFree does not persist audio or
                  transcripts. It stores a pseudonymous device ID plus model, duration, timestamps,
                  wallet, and operational records needed to meter and support the service. Optional
                  vocabulary and surrounding-context sharing are separate controls, both off by
                  default. Transcripts return to the app; history stays on your Mac.
                </p>
              </div>
              <div class="bg-amber-50 rounded-2xl p-6 border border-amber-100">
                <h3 class="font-semibold text-gray-900 mb-2">What OpenAI does with it</h3>
                <p class="text-gray-700">
                  As checked on October 17, 2026, OpenAI lists the audio-transcription endpoint as
                  having no abuse-monitoring or application-state retention. OpenAI also says API
                  data is not used for training unless the customer opts in. Provider policies can
                  change, so check
                  {' '}
                  <a
                    href="https://developers.openai.com/api/docs/guides/your-data"
                    class="text-teal-700 underline"
                    rel="noopener"
                  >OpenAI&rsquo;s live data-controls page</a>.
                </p>
              </div>
            </div>
          </div>
        </section>

        <!-- Credit and refund policy -->
        <section class="py-20 px-6 bg-gray-50">
          <div class="max-w-3xl mx-auto">
            <h2 class="text-3xl font-bold text-center mb-4">How credit works</h2>
            <p class="text-lg text-gray-600 text-center mb-12 max-w-2xl mx-auto">
              Purchased credit does not expire. It is tied to this Mac&rsquo;s pseudonymous device
              ID, not a WhisperFree login.
            </p>
            <div class="grid sm:grid-cols-2 gap-6">
              <div class="bg-white rounded-2xl p-6 border border-gray-100">
                <h3 class="font-semibold text-gray-900 mb-2">Failed requests are not charged</h3>
                <p class="text-gray-600 text-sm">
                  WhisperFree reserves an estimate, then charges only for a completed
                  transcription. Failed requests release the reservation automatically.
                </p>
              </div>
              <div class="bg-white rounded-2xl p-6 border border-gray-100">
                <h3 class="font-semibold text-gray-900 mb-2">Unused credit is refundable</h3>
                <p class="text-gray-600 text-sm">
                  A wholly unused purchase is fully refundable within 14 days. Otherwise, request
                  a refund of the unused portion. Consumed credit is non-refundable except for a
                  billing or service error, or where required by law.
                </p>
              </div>
              <div class="bg-white rounded-2xl p-6 border border-gray-100">
                <h3 class="font-semibold text-gray-900 mb-2">Save your device ID</h3>
                <p class="text-gray-600 text-sm">
                  If you lose this Mac, support can transfer remaining credit after you provide
                  the saved device ID and purchase receipt. Open requests must be resolved first.
                </p>
              </div>
              <div class="bg-white rounded-2xl p-6 border border-gray-100">
                <h3 class="font-semibold text-gray-900 mb-2">Planned US launch</h3>
                <p class="text-gray-600 text-sm">
                  Paid cloud credit is planned to launch first in the United States, subject to
                  checkout eligibility. Taxes, when applicable, are calculated separately at
                  checkout and do not become credit.
                </p>
              </div>
            </div>
          </div>
        </section>

        <!-- Closing -->
        <section class="py-20 px-6 bg-gray-50">
          <div class="max-w-3xl mx-auto text-center">
            <h2 class="text-3xl font-bold mb-4">Free to start, on your Mac</h2>
            <p class="text-lg text-gray-600 mb-8 max-w-2xl mx-auto">
              Download WhisperFree and dictate locally for free. Cloud models are there when you
              need them &mdash; no subscription, no WhisperFree login, off until you flip the switch.
            </p>
            <p class="text-gray-500">
              Curious why we price this way? Read
              {' '}
              <a href="/blog/why-we-price-at-cost" class="text-teal-700 underline">
                Why we price at cost + 10&cent;/hour</a>.
            </p>
          </div>
        </section>
      </>
    ) : (
      <section class="py-32 px-6">
        <div class="max-w-2xl mx-auto text-center">
          <h2 class="text-3xl font-bold mb-4">Cloud models are paused right now</h2>
          <p class="text-lg text-gray-600">
            Cloud transcription is temporarily unavailable. Local dictation still runs on your Mac,
            free, as always. Check back soon.
          </p>
        </div>
      </section>
    )}
  </main>
  <Footer />
</Layout>
